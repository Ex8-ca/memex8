# ─── memex8 ───────────────────────────────────────────────────────────────────
# ─── memex8 ───────────────────────────────────────────────────────────────────

# API key for REST/MCP authentication
# IMPORTANT: Change this from the default before deploying
MEMEX8_API_KEY=***

# OpenAI API key (required if EMBEDDING_PROVIDER=openai or CONSOLIDATION_BACKEND=openai)
# Leave empty if using Ollama for both embeddings and consolidation
OPENAI_API_KEY=***

# ─── Embedding Provider ────────────────────────────────────────────────
# Default: openai (uses text-embedding-3-small, 1536d)
# For local embeddings with Ollama, change to:
#   EMBEDDING_PROVIDER=ollama
#   EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_DIMENSIONS=768
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ─── Slumber Consolidation (Phase 6) ───────────────────────────────────
# Backend: "openai" (default, uses OPENAI_API_KEY)
#          "local" (uses LOCAL_LLM_URL below)
# Schedule: cron expression, default "0 3 * * *" (daily at 3am)
# Leave empty to use OpenAI gpt-4o-mini by default
# CONSOlidATION_BACKEND=openai
# CONSOLIDATION_MODEL=gpt-4o-mini
# CONSOLIDATION_SCHEDULE=0 3 * * *

# ─── Local LLM (for consolidation when backend="local") ───────────────────
# Any OpenAI-compatible endpoint (Ollama, TGI, LM Studio, etc.)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_API_KEY=

# ─── Qdrant ───────────────────────────────────────────────────────────────────
# Qdrant starts automatically via docker-compose.
# Inside Docker, Qdrant is at http://qdrant:6334 (gRPC port)
QDRANT_URL=http://qdrant:6334

# ─── Ollama (optional) ────────────────────────────────────────────────────────
# For local embeddings: docker compose --profile local-embeddings up -d
OLLAMA_URL=http://ollama:11434

# ─── Logging ──────────────────────────────────────────────────────────────────
# RUST_LOG=memex8=debug
