# memex8 API key (used for REST/MCP auth)
MEMEX8_API_KEY=your-api-key-here

# OpenAI API key (required if using OpenAI embeddings)
OPENAI_API_KEY=

# Qdrant URL (default: http://qdrant:6333 in Docker)
QDRANT_URL=http://qdrant:6333

# Ollama URL (default: http://ollama:11434 in Docker, or http://localhost:11434 local)
OLLAMA_URL=http://ollama:11434

# RUST_LOG=info
# MEMEX8_CONFIG=/etc/memex8/config.toml
