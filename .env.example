# ─── memex8 ───────────────────────────────────────────────────────────────────

# API key for REST/MCP authentication (required for production)
MEMEX8_API_KEY=memex8-dev-key

# OpenAI API key (required if EMBEDDING_PROVIDER=openai)
# Leave empty if using Ollama for local embeddings
OPENAI_API_KEY=

# ─── Embedding Provider ────────────────────────────────────────────────
# Default: openai (uses text-embedding-3-small, 1536d)
# For local embeddings with Ollama, change to:
#   EMBEDDING_PROVIDER=ollama
#   EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_DIMENSIONS=768
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ─── Qdrant ───────────────────────────────────────────────────────────────────
# Qdrant starts automatically via docker-compose.
# No need to install or run Qdrant separately.
# Inside Docker, Qdrant is at http://qdrant:6334 (gRPC port)
# For local development (outside Docker), use http://localhost:6334
QDRANT_URL=http://qdrant:6334

# ─── Ollama (optional) ────────────────────────────────────────────────────────
# For local embeddings: docker compose --profile local-embeddings up -d
# For local dev with Ollama running on host: http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434

# ─── Logging ──────────────────────────────────────────────────────────────────
# RUST_LOG=info
# RUST_LOG=memex8=debug

# ─── Config path ──────────────────────────────────────────────────────────────
# MEMEX8_CONFIG=/etc/memex8/config.toml
