# ─── memex8 environment — narrow secret scope ─────────────────────────────
#
# Copy this file to `.env.memex8` and fill in the values. The shipped
# `docker-compose.yml` mounts ONLY this file into the container, not
# your entire `~/.hermes/.env`. This keeps every other Hermes secret
# (other model keys, A2A tokens, etc.) out of the memex8 container.
#
#   cp .env.memex8.example .env.memex8
#   chmod 600 .env.memex8
#   $EDITOR .env.memex8
#
# After editing, recreate the container so the new env takes effect:
#
#   docker compose up -d --force-recreate --no-deps memex8

# API key for REST/MCP authentication. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MEMEX8_API_KEY=replace-me-with-a-secret-tokenurlsafe-key

# OpenAI API key (required if EMBEDDING_PROVIDER=openai or
# CONSOLIDATION_BACKEND=openai). Leave empty if using Ollama for both
# embeddings and consolidation.
OPENAI_API_KEY=sk-replace-me

# OpenAI-compatible API base URL (optional). Uncomment to use a
# non-OpenAI endpoint (MiniMax, Together AI, Groq, etc.) for embeddings.
# OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Embedding Provider ──────────────────────────────────────────────────
# Default: openai (uses text-embedding-3-small, 1536d).
# For fully local embeddings with Ollama:
#   EMBEDDING_PROVIDER=ollama
#   EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_DIMENSIONS=768
# For an OpenAI-compatible provider (MiniMax, Together, Groq, …):
#   EMBEDDING_PROVIDER=openai-compatible
#   EMBEDDING_MODEL=your-model-name
#   EMBEDDING_DIMENSIONS=your-dimensions
#   OPENAI_BASE_URL=https://api.minimax.io/v1
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ─── Slumber Consolidation (Phase 6) ─────────────────────────────────────
# CONSOlidATION_BACKEND=openai
# CONSOLIDATION_MODEL=gpt-4o-mini
# CONSOLIDATION_SCHEDULE=0 3 * * *

# ─── Local LLM (for consolidation when backend="local") ──────────────────
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_API_KEY=

# ─── Ollama (optional) ───────────────────────────────────────────────────
# For local embeddings: docker compose --profile local-embeddings up -d
OLLAMA_URL=http://ollama:11434

# ─── Logging ─────────────────────────────────────────────────────────────
# RUST_LOG=memex8=debug